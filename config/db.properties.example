# QuietSpot database settings.
# 1. Copy this file to config/db.properties  (that copy is private and is not committed to git)
# 2. Put your own MySQL login below.
db.host=localhost
db.port=3306
db.name=quietspot
db.user=root
db.password=

# Hosted database (for example TiDB Cloud): paste the full JDBC URL here instead.
# When db.url is set, db.host / db.port / db.name are ignored and the database must already exist.
# You can also set the environment variables DB_URL, DB_USER and DB_PASSWORD, which win over this file.
#db.url=jdbc:mysql://HOST:4000/quietspot?sslMode=VERIFY_IDENTITY